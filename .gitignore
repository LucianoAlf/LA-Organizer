.ssh/
scripts/setup-vps-key.sh
.mcp.json
node_modules/

# Sprint 22.26c — git credential manager (Windows) cria esse dir durante clone.
# Nao tem nada a ver com o repo; entrava no commit por engano.
system-commandline-sentinel-files/

# ── Migração p/ clone git (21/07) — scratch/local que NUNCA foi deployado.
# O hook antigo copiava só dirs específicas (src/skills/web/migrations/docs/scripts);
# o clone com `git add -A` precisa ignorar explicitamente o resto pra não varrer lixo.
/e2e-*.js
/tmp_*.js
# Scratch `tmp_*` em QUALQUER dir/extensão (05/08): o padrão acima é ancorado na raiz
# e só .js, então um `web/src/lib/tmp_diag_*.test.ts` escapava e o `git add -A` do
# auto-deploy commitava sonda alheia marcada "não commitar". Nenhum tracked casa
# `tmp_*` (o `e2e-*` continua ancorado — esse TEM rastreados em scripts/).
tmp_*
/test/
web/.claude/
.superpowers/

# Migrations do Supabase são aplicadas via MCP, não versionadas hoje (status quo — o
# hook antigo não as deployava). Versioná-las é decisão separada; por ora ficam fora.
/supabase/migrations/

# Cópia temporária que scripts/selftest-mutante.sh gera para sabotar o runner.
/scripts/.selftest-runner.sh

# Backups feitos à mão na VPS antes de deploy cirúrgico. Nunca versionar: em 09/08 havia 12
# deles em src/ somando ~6MB (8 cópias do engine.js), todos untracked e NÃO ignorados — um
# `git add -A` os teria commitado. O agente de governança tem git na VPS, então isso não era
# hipotético. Arquivados em /root/lixeira/src-orfaos-20260809.tar.gz e removidos.
*.bak
*.bak-*
*.pre-*.bak

# Lock de deploy — estado LOCAL de coordenacao entre chats. Versionar isto faz o lock
# viajar por commit/rebase e virar estado compartilhado: o hold de um chat some no pull do
# outro (DEPLOYHOLD-CAMINHO-INVISIVEL, 10/08).
.deploy-hold
